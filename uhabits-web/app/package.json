{
  "name": "loop-habits-web",
  "private": true,
  "version": "1.0.12",
  "type": "module",
  "license": "GPL-3.0-or-later",
  "scripts": {
    "core": "cd ../.. && ./gradlew :uhabits-web:jsBrowserProductionLibraryDistribution",
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:bridge": "vitest run --project bridge",
    "test:coverage": "vitest run --project unit --coverage",
    "test:ui": "npm run build && node ../tests/run-ui.js"
  },
  "dependencies": {
    "jszip": "3.10.1",
    "preact": "10.29.8",
    "sprintf-js": "1.1.3",
    "sql.js": "1.11.0"
  },
  "devDependencies": {
    "@preact/preset-vite": "2.10.6",
    "@testing-library/preact": "3.2.6",
    "@types/node": "22.20.5",
    "@types/sql.js": "1.4.9",
    "@vitest/coverage-v8": "5.0.5",
    "fake-indexeddb": "6.2.6",
    "happy-dom": "21.0.4",
    "playwright-core": "1.63.0",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vite-plugin-pwa": "1.3.0",
    "vitest": "5.0.5"
  }
}
